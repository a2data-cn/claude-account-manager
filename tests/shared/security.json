    {"name": "登录凭据和网页登录凭据", "text": "echo sk-ant-oat01-xxxxxxxxxxxxxxxxxxxx\necho sk-ant-ort01-xxxxxxxxxxxxxxxxxxxx\nset sk=sk-ant-sid01-xxxxxxxxxxxxxxxxxxxx\n", "want": {"count": 3, "kinds": ["登录凭据", "网页登录凭据"]}},
