{
  "_说明": "服务检测（cam doctor、面板“全面体检”、桌面版“重新检测”）的几条规则：proxy_endpoints([来源, 设置值]) 要看在不在运行的代理地址；auth_item([域名, HTTP 状态, 返回的文字, 毫秒]) 续登录的地址那一条；der_issuer(证书 DER 的十六进制) 颁发者；tls_issuer_item(域名, 颁发者, 本机认不认) 证书那一条；risk_score(条目) 新加的几种条目怎么扣分。Python 与 Rust 两边按同一份数据跑。",
  "proxy_endpoints": [
    {"name": "环境变量带账号密码：只要主机和端口", "entries": [["HTTPS_PROXY", "http://user:pass@127.0.0.1:7890"]], "expect": [["HTTPS_PROXY", "127.0.0.1", 7890]]},
    {"name": "环境变量没写协议", "entries": [["https_proxy", "127.0.0.1:7890"]], "expect": [["https_proxy", "127.0.0.1", 7890]]},
    {"name": "SOCKS 和 IPv6 地址", "entries": [["ALL_PROXY", "socks5://[::1]:7891"]], "expect": [["ALL_PROXY", "::1", 7891]]},
    {"name": "macOS 系统设置的写法", "entries": [["系统设置", "HTTPS 127.0.0.1:7890"], ["系统设置", "SOCKS 127.0.0.1:7891"]], "expect": [["系统设置", "127.0.0.1", 7890], ["系统设置", "127.0.0.1", 7891]]},
    {"name": "Windows 按协议分开写，同一个地址只留一次", "entries": [["系统设置", "系统代理 http=127.0.0.1:7890;https=127.0.0.1:7890;socks=127.0.0.1:7891"]], "expect": [["系统设置", "127.0.0.1", 7890], ["系统设置", "127.0.0.1", 7891]]},
    {"name": "PAC、没写端口、手动但没填的都不看", "entries": [["系统设置", "PAC http://wpad/proxy.pac"], ["HTTP_PROXY", "http://proxy.corp"], ["系统设置", "系统代理（手动）"]], "expect": []},
    {"name": "环境变量和系统设置是同一个地址：只留先出现的", "entries": [["HTTPS_PROXY", "http://127.0.0.1:7890"], ["系统设置", "HTTPS 127.0.0.1:7890"]], "expect": [["HTTPS_PROXY", "127.0.0.1", 7890]]},
    {"name": "最多 4 个", "entries": [["HTTPS_PROXY", "http://127.0.0.1:1"], ["HTTP_PROXY", "http://127.0.0.1:2"], ["ALL_PROXY", "socks5://127.0.0.1:3"], ["系统设置", "HTTPS 127.0.0.1:4"], ["系统设置", "SOCKS 127.0.0.1:5"]], "expect": [["HTTPS_PROXY", "127.0.0.1", 1], ["HTTP_PROXY", "127.0.0.1", 2], ["ALL_PROXY", "127.0.0.1", 3], ["系统设置", "127.0.0.1", 4]]},
    {"name": "密码里有 @ 和 /", "entries": [["HTTPS_PROXY", "http://us@er:p/w@10.0.0.1:3128/"]], "expect": [["HTTPS_PROXY", "10.0.0.1", 3128]]},
    {"name": "端口不对的不看", "entries": [["HTTPS_PROXY", "http://127.0.0.1:70000"], ["HTTP_PROXY", "http://localhost:0"], ["ALL_PROXY", "http://h:x"]], "expect": []},
    {"name": "主机名大小写不同算同一个", "entries": [["HTTPS_PROXY", "http://Proxy.Corp:8080"], ["HTTP_PROXY", "http://proxy.corp:8080"]], "expect": [["HTTPS_PROXY", "Proxy.Corp", 8080]]}
  ],
  "auth_item": [
    {"name": "两个都回 405：连得上", "results": [["platform.claude.com", 405, "{\"error\":{\"message\":\"Method Not Allowed\"}}", 55], ["console.anthropic.com", 405, "{}", 120]], "expect": {"level": "ok", "text": "续登录的地址连得上：platform.claude.com（55 ms）、console.anthropic.com（120 ms）"}},
    {"name": "一个连不上", "results": [["platform.claude.com", 405, "{}", 55], ["console.anthropic.com", 0, "网络错误：timed out", null]], "expect": {"level": "warn", "text": "续登录的地址有的连不上：console.anthropic.com 连不上；platform.claude.com（55 ms）连得上"}},
    {"name": "都连不上", "results": [["platform.claude.com", 0, "网络错误：x", null], ["console.anthropic.com", 0, "网络错误：y", null]], "expect": {"level": "bad", "text": "续登录的地址都连不上：platform.claude.com 连不上、console.anthropic.com 连不上"}},
    {"name": "人机验证页算拦住了", "results": [["platform.claude.com", 403, "<html><head><title>Just a moment...</title></head><body>cf-chl</body></html>", 80], ["console.anthropic.com", 405, "{}", 90]], "expect": {"level": "warn", "text": "续登录的地址有的连不上：platform.claude.com 返回人机验证页；console.anthropic.com（90 ms）连得上"}},
    {"name": "因为地区拒绝算拦住了", "results": [["platform.claude.com", 403, "{\"error\":{\"message\":\"Unsupported country\"}}", 80]], "expect": {"level": "bad", "text": "续登录的地址都连不上：platform.claude.com 拒绝访问（HTTP 403）"}},
    {"name": "普通的 403、503 也算连得上", "results": [["platform.claude.com", 403, "{\"error\":{\"message\":\"forbidden\"}}", 80], ["console.anthropic.com", 503, "{\"error\":\"down\"}", 70]], "expect": {"level": "ok", "text": "续登录的地址连得上：platform.claude.com（80 ms）、console.anthropic.com（70 ms）"}},
    {"name": "503 的人机验证页算拦住了", "results": [["platform.claude.com", 503, "<html><head><title>Just a moment...</title></head><body>cf-chl</body></html>", 80]], "expect": {"level": "bad", "text": "续登录的地址都连不上：platform.claude.com 返回人机验证页"}}
  ],
  "der_issuer": [
    {"name": "Google Trust Services，EC 证书", "der_hex": "", "expect": {"org": "Google Trust Services", "cn": "WE1"}},
    {"name": "Fortinet，RSA 2048（长度占两个字节）", "der_hex": "", "expect": {"org": "Fortinet", "cn": "FortiGate CA"}},
    {"name": "只有通用名 mitmproxy", "der_hex": "", "expect": {"cn": "mitmproxy"}},
    {"name": "组织名是中文（UTF8String）", "der_hex": "", "expect": {"org": "深信服科技", "cn": "Sangfor SSL CA"}},
    {"name": "空的", "der_hex": "", "expect": null},
    {"name": "截断的", "der_hex": "3082", "expect": null},
    {"name": "不是证书", "der_hex": "3003020100", "expect": null},
    {"name": "长度越界", "der_hex": "30820fff3003020100", "expect": null}
  ],
  "tls_issuer_item": [
    {"name": "Google Trust Services：公共证书机构", "host": "api.anthropic.com", "issuer": {"org": "Google Trust Services", "cn": "WE1"}, "verified": true, "expect": {"kind": "tls_chain", "level": "ok", "text": "HTTPS 证书：api.anthropic.com 由 Google Trust Services 签发（公共证书机构，没有被中间设备解密）"}},
    {"name": "Let's Encrypt", "host": "claude.ai", "issuer": {"org": "Let's Encrypt", "cn": "YE2"}, "verified": true, "expect": {"kind": "tls_chain", "level": "ok", "text": "HTTPS 证书：claude.ai 由 Let's Encrypt 签发（公共证书机构，没有被中间设备解密）"}},
    {"name": "Python 不认但是公共证书机构（python.org 版没装证书）", "host": "api.anthropic.com", "issuer": {"org": "DigiCert Inc", "cn": "x"}, "verified": false, "expect": {"kind": "tls_chain", "level": "ok", "text": "HTTPS 证书：api.anthropic.com 由 DigiCert Inc 签发（公共证书机构，没有被中间设备解密）"}},
    {"name": "公司网关，本机认它（证书装进了系统）", "host": "api.anthropic.com", "issuer": {"org": "Fortinet", "cn": "FortiGate CA"}, "verified": true, "expect": {"kind": "tls_intercept", "level": "warn", "text": "HTTPS 证书：api.anthropic.com 由 Fortinet 签发，不是公共证书机构：网络里有设备在解密 HTTPS"}},
    {"name": "抓包工具，本机不认", "host": "api.anthropic.com", "issuer": {"cn": "mitmproxy"}, "verified": false, "expect": {"kind": "tls_intercept", "level": "warn", "text": "HTTPS 证书：api.anthropic.com 由 mitmproxy 签发，不是公共证书机构：网络里有设备在解密 HTTPS，本机不认它"}},
    {"name": "什么名字都没有", "host": "api.anthropic.com", "issuer": {}, "verified": true, "expect": {"kind": "tls_intercept", "level": "warn", "text": "HTTPS 证书：api.anthropic.com 由 ? 签发，不是公共证书机构：网络里有设备在解密 HTTPS"}}
  ],
  "risk_score": [
    {"name": "续登录的地址都连不上", "items": [{"kind": "auth", "level": "bad"}], "expect": 80},
    {"name": "续登录的地址有的连不上", "items": [{"kind": "auth", "level": "warn"}], "expect": 95},
    {"name": "代理没开不另外扣分（连不上的那几项已经扣了）", "items": [{"kind": "proxy_down", "level": "bad"}, {"kind": "api", "level": "bad"}], "expect": 60},
    {"name": "HTTPS 被解密不扣分（不是所在地的信号）", "items": [{"kind": "tls_intercept", "level": "warn"}, {"kind": "tls_chain", "level": "ok"}], "expect": 100},
    {"name": "状态页：有关组件严重故障", "items": [{"kind": "status", "level": "bad"}], "expect": 70},
    {"name": "状态页：留意", "items": [{"kind": "status", "level": "warn"}], "expect": 90},
    {"name": "代理在运行、续登录正常不扣分", "items": [{"kind": "proxy_up", "level": "ok"}, {"kind": "auth", "level": "ok"}], "expect": 100}
  ]
}
