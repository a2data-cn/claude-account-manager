{
  "_说明": "手动字段：parse_day 认哪些到期日写法；apply_manual 把编辑表单写进账号（出错时 expect 为 null，账号不应被改动）；days_left 按手填到期日算剩余天数。",
  "parse_day": [
    {"name": "标准写法", "input": "2026-11-03", "expect": "2026-11-03"},
    {"name": "后面跟 T 开头的时间", "input": "2026-11-03T08:00:00Z", "expect": "2026-11-03"},
    {"name": "后面跟空格开头的时间", "input": "2026-11-03 08:00", "expect": "2026-11-03"},
    {"name": "闰日", "input": "2024-02-29", "expect": "2024-02-29"},
    {"name": "后面跟其它字符", "input": "2026-11-03x", "expect": null},
    {"name": "月日不补零", "input": "2026-1-3", "expect": null},
    {"name": "斜杠分隔", "input": "2026/11/03", "expect": null},
    {"name": "不存在的日期", "input": "2026-02-30", "expect": null},
    {"name": "全角数字", "input": "２０２６-１１-０３", "expect": null},
    {"name": "混了一个全角数字", "input": "2026-11-0３", "expect": null},
    {"name": "前面有空格", "input": " 2026-11-03", "expect": null},
    {"name": "空字符串", "input": "", "expect": null}
  ],
  "account": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月"}},
  "apply": [
    {"name": "整份表单提交，到期日没变，扣费日保留",
     "fields": {"label": "工作号", "plan": "", "expires_at": "2026-10-31", "auto_renew": true, "cycle": "monthly", "price": "$100/月", "note": "", "app_mode": false},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月", "plan": null, "cycle": "monthly", "note": null, "app_mode": false}}},
    {"name": "改了到期日，清掉扣费日",
     "fields": {"expires_at": "2026-11-15"},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-11-15", "auto_renew": true, "price": "$100/月"}}},
    {"name": "到期日带时间只留日期，日期没变，扣费日保留",
     "fields": {"expires_at": "2026-10-31T08:00:00Z"},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月"}}},
    {"name": "到期日传空字符串是清除",
     "fields": {"expires_at": ""},
     "expect": {"label": "工作号", "manual": {"expires_at": null, "auto_renew": true, "price": "$100/月"}}},
    {"name": "到期日传 null 也是清除",
     "fields": {"expires_at": null},
     "expect": {"label": "工作号", "manual": {"expires_at": null, "auto_renew": true, "price": "$100/月"}}},
    {"name": "开关传空字符串是清除",
     "fields": {"auto_renew": ""},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": null, "renew_day": 31, "price": "$100/月"}}},
    {"name": "没提到的字段不动",
     "fields": {"note": "备注"},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月", "note": "备注"}}},
    {"name": "名称去掉首尾空格，最多 60 个字",
     "fields": {"label": "  一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十 "},
     "expect": {"label": "一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月"}}},
    {"name": "名称全是空格时保持原名",
     "fields": {"label": "   "},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月"}}},
    {"name": "名称传 null 时不动",
     "fields": {"label": null},
     "expect": {"label": "工作号", "manual": {"expires_at": "2026-10-31", "auto_renew": true, "renew_day": 31, "price": "$100/月"}}},
    {"name": "名称不是文字", "fields": {"label": 123}, "expect": null},
    {"name": "到期日格式不对", "fields": {"expires_at": "2026/11/03"}, "expect": null},
    {"name": "到期日用全角数字", "fields": {"expires_at": "２０２６-１１-０３"}, "expect": null},
    {"name": "到期日不存在", "fields": {"expires_at": "2026-02-30"}, "expect": null},
    {"name": "到期日不是文字", "fields": {"expires_at": 20261103}, "expect": null},
    {"name": "开关传字符串 true", "fields": {"auto_renew": "true"}, "expect": null},
    {"name": "开关传 1", "fields": {"app_mode": 1}, "expect": null},
    {"name": "cycle 只能是 monthly 或 yearly", "fields": {"cycle": "weekly"}, "expect": null},
    {"name": "文字字段不收数字", "fields": {"price": 100}, "expect": null},
    {"name": "后面的字段出错，前面的名称也不改", "fields": {"label": "新名字", "note": "备注", "expires_at": "bad"}, "expect": null}
  ],
  "days_left": [
    {"name": "还有 15 天", "today": "2026-10-19", "account": {"manual": {"expires_at": "2026-11-03"}}, "expect": 15},
    {"name": "当天到期是 0", "today": "2026-10-19", "account": {"manual": {"expires_at": "2026-10-19"}}, "expect": 0},
    {"name": "已过期是负数", "today": "2026-10-19", "account": {"manual": {"expires_at": "2026-10-01"}}, "expect": -18},
    {"name": "手填到期日带时间，只看日期，不换算时区", "today": "2026-10-19", "account": {"manual": {"expires_at": "2026-11-03T23:59:59Z"}}, "expect": 15},
    {"name": "手填到期日格式不对时不回退到接口时间", "today": "2026-10-19",
     "account": {"manual": {"expires_at": "2026/11/03"}, "auto": {"subscription_expires_at": "2026-12-01T12:00:00Z"}}, "expect": null},
    {"name": "都没填", "today": "2026-10-19", "account": {"manual": {"expires_at": ""}}, "expect": null}
  ]
}
