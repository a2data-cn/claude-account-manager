{
  "_说明": "Windows 上合并以后的两次 PowerShell 查询怎么解析：parse_windows_env（DNS、系统语言、默认路由的网卡，ConvertTo-Json 的输出）、parse_windows_processes（进程表，每行 pid、程序路径、名字、命令行，用 Tab 分开）。Python 与 Rust 两边按同一份数据跑。",
  "env": [
    {"name": "正常：两个 DNS、语言、默认路由的网卡", "output": "{\"dns\":[\"192.168.1.1\",\"fe80::1\"],\"culture\":\"zh-CN\",\"route\":\"WLAN\",\"route_desc\":\"Intel(R) Wi-Fi 6 AX201 160MHz\"}", "expect": {"dns": ["192.168.1.1", "fe80::1"], "culture": "zh-CN", "route": "WLAN", "route_desc": "Intel(R) Wi-Fi 6 AX201 160MHz", "wlan": ""}},
    {"name": "只有一个 DNS 时 PowerShell 可能给成字符串", "output": "{\"dns\":\"10.0.0.1\",\"culture\":\"en-US\",\"route\":\"以太网\",\"route_desc\":\"Realtek PCIe GbE Family Controller\"}", "expect": {"dns": ["10.0.0.1"], "culture": "en-US", "route": "以太网", "route_desc": "Realtek PCIe GbE Family Controller", "wlan": ""}},
    {"name": "前面有警告、后面有空行", "output": "WARNING: something\r\n{\"dns\":[],\"culture\":\"ja-JP\",\"route\":\"\",\"route_desc\":\"\"}\r\n\r\n", "expect": {"dns": [], "culture": "ja-JP", "route": "", "route_desc": "", "wlan": ""}},
    {"name": "走 VPN 的网卡", "output": "{\"dns\":[\"198.18.0.2\"],\"culture\":\"zh-CN\",\"route\":\"Meta\",\"route_desc\":\"Meta Tunnel\"}", "expect": {"dns": ["198.18.0.2"], "culture": "zh-CN", "route": "Meta", "route_desc": "Meta Tunnel", "wlan": ""}},
    {"name": "各项是 null", "output": "{\"dns\":null,\"culture\":null,\"route\":null,\"route_desc\":null}", "expect": {"dns": [], "culture": "", "route": "", "route_desc": "", "wlan": ""}},
    {"name": "不是 JSON", "output": "Get-NetRoute : 找不到", "expect": {"dns": [], "culture": "", "route": "", "route_desc": "", "wlan": ""}},
    {"name": "空的", "output": "", "expect": {"dns": [], "culture": "", "route": "", "route_desc": "", "wlan": ""}},
    {"name": "带着 netsh wlan 的输出（base64）：解出原文，中文不乱", "output": "{\"dns\": [\"192.168.1.1\"], \"culture\": \"zh-CN\", \"route\": \"WLAN\", \"route_desc\": \"Intel(R) Wi-Fi 6\", \"wlan\": \"\"}", "expect": {"dns": ["192.168.1.1"], "culture": "zh-CN", "route": "WLAN", "route_desc": "Intel(R) Wi-Fi 6", "wlan": "\r\n系统上有 1 个接口:\r\n\r\n    名称                     : Wi-Fi\r\n    描述                     : Intel(R) Wi-Fi 6 AX201 160MHz\r\n    GUID                   : 11111111-2222-3333-4444-555555555555\r\n    物理地址                   : aa:bb:cc:dd:ee:ff\r\n    状态                     : 已连接\r\n    SSID                   : 机场免费WiFi\r\n    BSSID                  : 11:22:33:44:55:66\r\n    网络类型                   : 结构\r\n    无线电类型                  : 802.11ac\r\n    身份验证                   : 开放式\r\n    密码                     : 无\r\n    连接模式                   : 自动连接\r\n    信道                     : 36\r\n    信号                     : 90%\r\n    配置文件                   : 机场免费WiFi\r\n\r\n"}},
    {"name": "wlan 不是 base64：当没有", "output": "{\"dns\": [], \"culture\": \"en-US\", \"route\": \"\", \"route_desc\": \"\", \"wlan\": \"\\u4e0d\\u662f base64 !!\"}", "expect": {"dns": [], "culture": "en-US", "route": "", "route_desc": "", "wlan": ""}}
  ],
  "processes": [
    {"name": "正常的几行：程序路径、名字、命令行", "output": "4\t\tSystem\t\r\n1234\tC:\\Users\\me\\AppData\\Local\\AnthropicClaude\\app-1.0.3\\claude.exe\tclaude.exe\t\"C:\\Users\\me\\AppData\\Local\\AnthropicClaude\\app-1.0.3\\claude.exe\" --user-data-dir=C:\\x\r\n5678\tC:\\Program Files\\nodejs\\node.exe\tnode.exe\tnode C:\\npm\\claude\\cli.js --resume\tx\r\n", "expect": [[4, "", "System", ""], [1234, "C:\\Users\\me\\AppData\\Local\\AnthropicClaude\\app-1.0.3\\claude.exe", "claude.exe", "\"C:\\Users\\me\\AppData\\Local\\AnthropicClaude\\app-1.0.3\\claude.exe\" --user-data-dir=C:\\x"], [5678, "C:\\Program Files\\nodejs\\node.exe", "node.exe", "node C:\\npm\\claude\\cli.js --resume\tx"]]},
    {"name": "pid 不是数字、少了几列的不要", "output": "abc\tx\ty\tz\n12\tonly\ttwo\n", "expect": []}
  ]
