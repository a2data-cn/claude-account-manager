{
  "_说明": "切号规则：校验/规范化，以及按时间匹配。时间是本地时间；2026-10-12 是周一。",
  "accounts": [
    {"id": "a", "kind": "claude_code"},
    {"id": "b", "kind": "claude_code"},
    {"id": "w", "kind": "claude_web"}
  ],
  "validate": [
    {"name": "补零、展开星期",
     "input": [{"id": "r1", "type": "time", "days": "1-5", "start": "9:00", "end": "18:30", "account": "a"}],
     "expect": [{"id": "r1", "type": "time", "days": [1, 2, 3, 4, 5], "start": "09:00", "end": "18:30", "account": "a"}]},
    {"name": "全角逗号、乱序去重",
     "input": [{"id": "r1", "type": "time", "days": "5，1,3,3", "start": "22:00", "end": "02:00", "account": "b"}],
     "expect": [{"id": "r1", "type": "time", "days": [1, 3, 5], "start": "22:00", "end": "02:00", "account": "b"}]},
    {"name": "不填星期就是每天，24:00 合法",
     "input": [{"id": "r1", "type": "time", "start": "00:00", "end": "24:00", "account": "a"}],
     "expect": [{"id": "r1", "type": "time", "days": [1, 2, 3, 4, 5, 6, 7], "start": "00:00", "end": "24:00", "account": "a"}]},
    {"name": "星期用数组",
     "input": [{"id": "r1", "type": "time", "days": [7, 6], "start": "10:00", "end": "12:00", "account": "a"}],
     "expect": [{"id": "r1", "type": "time", "days": [6, 7], "start": "10:00", "end": "12:00", "account": "a"}]},
    {"name": "目录去掉首尾空格",
     "input": [{"id": "r2", "type": "dir", "path": "  ~/work ", "account": "b"}],
     "expect": [{"id": "r2", "type": "dir", "path": "~/work", "account": "b"}]},
    {"name": "星期越界", "input": [{"id": "r", "type": "time", "days": "8", "start": "1:00", "end": "2:00", "account": "a"}], "expect": null},
    {"name": "小时越界", "input": [{"id": "r", "type": "time", "days": "1", "start": "25:00", "end": "2:00", "account": "a"}], "expect": null},
    {"name": "开始等于结束", "input": [{"id": "r", "type": "time", "days": "1", "start": "9:00", "end": "09:00", "account": "a"}], "expect": null},
    {"name": "时间格式不对", "input": [{"id": "r", "type": "time", "days": "1", "start": "9点", "end": "10:00", "account": "a"}], "expect": null},
    {"name": "网页账号不能用", "input": [{"id": "r", "type": "dir", "path": "~/x", "account": "w"}], "expect": null},
    {"name": "账号不存在", "input": [{"id": "r", "type": "dir", "path": "~/x", "account": "zz"}], "expect": null},
    {"name": "目录为空", "input": [{"id": "r", "type": "dir", "path": "  ", "account": "a"}], "expect": null},
    {"name": "类型不对", "input": [{"id": "r", "type": "weekly", "account": "a"}], "expect": null}
  ],
  "match_rules": [
    {"id": "work", "type": "time", "days": [1, 2, 3, 4, 5], "start": "09:00", "end": "18:00", "account": "a"},
    {"id": "night", "type": "time", "days": [5], "start": "22:00", "end": "02:00", "account": "b"},
    {"id": "late", "type": "time", "days": [1, 2, 3, 4, 5, 6, 7], "start": "17:00", "end": "23:00", "account": "b"},
    {"id": "d", "type": "dir", "path": "~/x", "account": "a"}
  ],
  "match": [
    {"at": "2026-10-12T10:00", "expect": "work", "name": "周一上班时间"},
    {"at": "2026-10-12T09:00", "expect": "work", "name": "开始时刻算在内"},
    {"at": "2026-10-12T18:00", "expect": "late", "name": "结束时刻不算在内，落到下一条"},
    {"at": "2026-10-12T17:30", "expect": "work", "name": "重叠时取第一条"},
    {"at": "2026-10-17T10:00", "expect": null, "name": "周六上午"},
    {"at": "2026-10-16T23:30", "expect": "night", "name": "周五夜里"},
    {"at": "2026-10-17T01:59", "expect": "night", "name": "跨午夜按开始那天算星期"},
    {"at": "2026-10-17T02:00", "expect": null, "name": "跨午夜的结束时刻"},
    {"at": "2026-10-18T01:00", "expect": null, "name": "周日凌晨不属于周五的规则"}
  ]
}
